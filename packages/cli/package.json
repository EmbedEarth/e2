{
  "name": "@embedearth/cli",
  "version": "0.1.15",
  "type": "module",
  "bin": {
    "earth": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/copy-region-catalog.mjs dist",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
